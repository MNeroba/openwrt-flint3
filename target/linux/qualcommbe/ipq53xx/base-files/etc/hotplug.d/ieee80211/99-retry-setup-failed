#!/bin/sh
# The AHB (2.4 GHz) component of the IPQ53xx multi-radio wiphy can finish
# probing after netifd's first wireless setup pass, which leaves its radio
# in retry_setup_failed ("wifi-scripts: Bug: PHY is undefined for device").
# When a phy appears, re-kick wireless setup if any radio is stuck.
[ "$ACTION" = "add" ] || exit 0
(
	sleep 10
	ubus call network.wireless status 2>/dev/null | \
		grep -q '"retry_setup_failed": true' || exit 0
	logger -t wifi-retry "phy added late; retrying failed radio setup"
	wifi up
) &
